---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PUBLISHED } from '../../data/countries';
import { SECTORS, byDate, formatDate, readingTime, type Guia } from '../../data/guias';

export async function getStaticPaths() {
  const guias = (await getCollection('guias', (g) => !g.data.draft)).sort(byDate);
  return guias.map((guia) => ({
    params: { slug: guia.id },
    props: { guia, related: guias.filter((g) => g.id !== guia.id && g.data.sector === guia.data.sector).slice(0, 3) },
  }));
}

const { guia, related } = Astro.props as { guia: Guia; related: Guia[] };
const { Content, headings } = await render(guia);
const toc = headings.filter((h) => h.depth === 2);
const { title, description, sector, published, updated } = guia.data;
const sectorLabel = SECTORS[sector].label;
const sectorNoun = SECTORS[sector].noun;

const site = Astro.site ?? new URL('https://www.novusance.com');
const url = new URL(`/guias/${guia.id}`, site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    inLanguage: 'es',
    datePublished: published,
    dateModified: updated ?? published,
    mainEntityOfPage: url,
    image: new URL('/og.png', site).href,
    author: { '@type': 'Organization', name: 'Novusance', url: site.href },
    publisher: {
      '@type': 'Organization',
      name: 'Novusance',
      logo: { '@type': 'ImageObject', url: new URL('/Novusance-Logo.png', site).href },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Guías', item: new URL('/guias', site).href },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  },
];
---

<BaseLayout title={`${title} · Novusance`} description={description} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="wrap layout">
  <article class="guia">
    <nav class="crumbs" aria-label="Ruta">
      <a href="/guias">Guías</a>
      <Icon name="ph:caret-right" size={14} aria-hidden="true" />
      <span>{sectorLabel}</span>
    </nav>

    <header class="head">
      <h1 class="display title">{title}</h1>
      <p class="lead muted">{description}</p>
      <p class="meta">
        <time datetime={published}>{formatDate(published)}</time>
        {
          updated && updated !== published && (
            <>
              {' '}
              · Actualizada el <time datetime={updated}>{formatDate(updated)}</time>
            </>
          )
        } · {readingTime(guia.body)} min de lectura
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <aside class="cta" aria-labelledby="cta-title">
      <h2 id="cta-title" class="display cta-title">¿Quieres ver cómo quedaría la web de tu {sectorNoun}?</h2>
      <p class="muted">
        Te preparo la portada con tu logo y tus colores, sin compromiso. Si te convence, seguimos; si no, no pasa nada.
      </p>
      <div class="cta-actions">
        {
          PUBLISHED.map((c, i) => (
            <a href={`${c.path}/${sector}#contacto`} class={`btn btn-lg ${i === 0 ? 'btn-ink' : 'btn-outline'}`}>
              Pedir propuesta · {c.name}
            </a>
          ))
        }
      </div>
    </aside>

    {
      related.length > 0 && (
        <nav class="related" aria-labelledby="related-title">
          <h2 id="related-title" class="eyebrow">
            Más guías para {sectorLabel.toLowerCase()}
          </h2>
          <ul>
            {related.map((g) => (
              <li>
                <a href={`/guias/${g.id}`}>{g.data.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <a class="back" href="/guias"><Icon name="ph:arrow-left" size={16} /> Todas las guías</a>
  </article>

  {
    toc.length > 1 && (
      <aside class="side" aria-labelledby="side-title">
        <div class="side-inner">
          <h2 id="side-title" class="eyebrow">
            En esta guía
          </h2>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
          <a href={`${PUBLISHED[0].path}#contacto`} class="btn btn-ink side-btn">
            Pide tu propuesta
          </a>
        </div>
      </aside>
    )
  }
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 70ch) 260px;
    justify-content: space-between;
    gap: 64px;
  }

  .guia {
    min-width: 0;
    padding-block: 40px 104px;
  }

  /* Índice lateral fijo, solo en pantallas anchas. */
  .side {
    padding-top: 40px;
  }

  .side-inner {
    position: sticky;
    top: 108px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
  }

  .side h2 {
    margin: 0 0 12px;
  }

  .side ol {
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.4;
  }

  .side li a {
    display: block;
    padding: 7px 0;
    color: var(--muted);
    text-decoration: none;
  }

  .side li a:hover,
  .side li a.is-active {
    color: var(--ink);
    opacity: 1;
  }

  .side-btn {
    width: 100%;
  }

  @media (max-width: 1100px) {
    .layout {
      display: block;
    }

    .guia {
      max-width: 70ch;
      margin-inline: auto;
    }

    .side {
      display: none;
    }
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 32px;
    font-size: 14px;
    color: var(--muted);
  }

  .crumbs a {
    color: var(--accent-text);
    text-decoration: none;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }

  .title {
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.05;
  }

  .lead {
    margin: 0;
    font-size: 19px;
    line-height: 1.55;
  }

  .meta {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .prose {
    font-size: 18px;
    line-height: 1.72;
  }

  .prose :global(h2) {
    margin: 52px 0 14px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 700;
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    scroll-margin-top: 92px;
  }

  .prose :global(h3) {
    margin: 32px 0 8px;
    font-size: 19px;
    font-weight: 600;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 18px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }

  .prose :global(li) {
    margin-bottom: 8px;
  }

  .prose :global(li::marker) {
    color: var(--accent-text);
  }

  .prose :global(a) {
    color: var(--accent-text);
    text-underline-offset: 3px;
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(blockquote) {
    margin: 28px 0;
    padding: 20px 24px;
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--r-card) var(--r-card) 0;
    background: var(--accent-soft);
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .cta {
    margin-top: 64px;
    padding: 36px;
    border: 1px solid var(--line);
    border-radius: var(--r-big);
    background: var(--surface);
  }

  .cta-title {
    font-size: clamp(24px, 2.8vw, 32px);
    line-height: 1.12;
  }

  .cta p {
    margin: 12px 0 24px;
    font-size: 17px;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .related {
    margin-top: 56px;
  }

  .related h2 {
    margin: 0 0 12px;
  }

  .related ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .related a {
    display: flex;
    align-items: center;
    min-height: 56px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-weight: 500;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-top: 40px;
    color: var(--muted);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    .cta {
      padding: 24px;
    }

    .cta-actions .btn {
      width: 100%;
      white-space: normal;
    }
  }
</style>

<script>
  // Resalta en el índice lateral la sección que se está leyendo: la última cuyo título ya ha pasado bajo la cabecera.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.side li a')];
  const heads = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((h): h is HTMLElement => h !== null);
  if (links.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      let current = -1;
      heads.forEach((h, i) => {
        if (h.getBoundingClientRect().top < 140) current = i;
      });
      links.forEach((a, i) => a.classList.toggle('is-active', i === current));
    };
    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>
