---
// Portada general de cada país: /es y /co.
import Landing from '../components/Landing.astro';
import { COUNTRY_LIST, type Country } from '../data/countries';

export function getStaticPaths() {
  return COUNTRY_LIST.map((c) => ({ params: { country: c.code }, props: { country: c } }));
}

const { country } = Astro.props as { country: Country };
---

<Landing country={country} />
