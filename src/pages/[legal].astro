---
import { getCollection } from 'astro:content';
import LegalPage from '../components/LegalPage.astro';
import { COUNTRIES } from '../data/countries';

// Páginas legales de España (titular: Juan Ignacio Moreno).
export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((page) => ({ params: { legal: page.id }, props: { page } }));
}

const { page } = Astro.props;
---

<LegalPage page={page} country={COUNTRIES.es} />
