---
import { Icon } from 'astro-icon/components';

import type { Country } from '../data/countries';

const { country } = Astro.props as { country: Country };

const faqs = [
  {
    q: '¿Tengo que pagar algo por ver la propuesta?',
    a: 'No. Te preparo la portada con tu logo y tus colores, te la enseño y decides. Si no te convence, no pasa nada.',
  },
  {
    q: '¿Qué tengo que aportar yo?',
    a: 'Fotos del local y del equipo, tu logo en buena calidad y acceso al panel de tu dominio. Si no tienes fotos buenas, te digo qué hacer o lo presupuestamos aparte.',
  },
  {
    q: '¿De quién es el dominio?',
    a: 'Tuyo, siempre a nombre de tu negocio. Yo solo cambio la configuración necesaria para que apunte a la nueva web.',
  },
  {
    q: '¿Se me va a cortar el correo al cambiar de web?',
    a: 'No. Antes de tocar el dominio compruebo si tu correo depende de él y lo dejo funcionando igual que antes.',
  },
  {
    q: '¿Cuánto tardas?',
    a: 'Una renovación, de 2 a 3 semanas; una web nueva, de 2 a 4. Cuenta desde que tengo tus fotos y tu logo.',
  },
  {
    q: '¿Qué pasa si quiero dejar el mantenimiento?',
    a: `La cuota tiene una permanencia de 12 meses. Si te vas antes, pagas la diferencia hasta el precio de la web sin cuota. Después, avisas con 30 días y listo; tu dominio sigue siendo tuyo.`,
  },
  {
    q: '¿La web cumple con la normativa?',
    a:
      country.code === 'es'
        ? 'Incluye aviso legal y política de privacidad según el RGPD. Si la web no usa cookies que necesiten consentimiento, no hace falta banner; si las usa, va un banner con «Rechazar» tan visible como «Aceptar».'
        : 'Incluye aviso legal y política de tratamiento de datos según la Ley 1581 de 2012 (habeas data).',
  },
];
---

<section id="preguntas" class="band">
  <div class="inner">
    <h2 class="display h2">Preguntas frecuentes</h2>
    <div class="list">
      {
        faqs.map((f) => (
          <details>
            <summary>
              <span>{f.q}</span>
              <Icon name="ph:plus" size={20} class="toggle" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .inner {
    max-width: 860px;
    margin-inline: auto;
    padding: 104px var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    font-size: 18px;
    font-weight: 600;
  }

  summary :global(.toggle) {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 0.25s;
  }

  details[open] summary :global(.toggle) {
    transform: rotate(45deg);
  }

  p {
    margin: -8px 0 0;
    padding-bottom: 22px;
    max-width: 720px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
