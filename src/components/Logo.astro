---
import { LOGO_FLAT, LOGO_GRADIENT, LOGO_PATH, LOGO_VIEWBOX } from '../data/logo';

interface Props {
  size: number;
  /** Degradado: solo en el bloque grande de contacto. */
  gradient?: boolean;
  class?: string;
}

const { size, gradient = false, class: className } = Astro.props;
const gradId = 'nv-logo-grad';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={LOGO_VIEWBOX}
  aria-hidden="true"
  focusable="false"
>
  {
    gradient && (
      <defs>
        <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color={LOGO_GRADIENT[0]} />
          <stop offset="1" stop-color={LOGO_GRADIENT[1]} />
        </linearGradient>
      </defs>
    )
  }
  <path d={LOGO_PATH} fill={gradient ? `url(#${gradId})` : LOGO_FLAT} />
</svg>
