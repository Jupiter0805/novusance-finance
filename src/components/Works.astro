---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { optionalImage } from '../lib/optional-image';

const works = [
  {
    href: 'https://www.mcprimehome.com',
    name: 'MC Prime Home',
    text: 'Web para una agencia inmobiliaria con operaciones en Madrid y Florida.',
    img: optionalImage('mcprimehome_landing'),
    placeholder: '[Captura de mcprimehome.com]',
    main: true,
  },
  {
    href: 'https://www.sirrux.net',
    name: 'SIRRUX',
    text: 'Espacio de análisis para inversores donde cada dato muestra su fuente.',
    img: optionalImage('sirrux_landing'),
    placeholder: '[Captura de sirrux.net]',
    main: false,
  },
  {
    href: 'https://ova.vercel.app',
    name: 'OVA',
    text: 'Plataforma educativa interactiva sobre periodontitis para una universidad.',
    img: optionalImage('Ova_landing'),
    placeholder: '[Captura de ova.vercel.app]',
    main: false,
  },
];
---

<section id="trabajos" class="band">
  <div class="wrap inner">
    <h2 class="display h2">Webs que ya están funcionando.</h2>
    <div class="grid">
      {
        works.map((w) => (
          <a href={w.href} class:list={['work', { 'work-main': w.main }]} target="_blank" rel="noopener">
            <div class="shot">
              {w.img ? (
                <Image
                  src={w.img}
                  alt={`Portada de la web de ${w.name}`}
                  widths={w.main ? [640, 960, 1280, 1904] : [480, 800, 1200]}
                  sizes={w.main ? '(max-width: 1240px) 100vw, 1192px' : '(max-width: 860px) 100vw, 590px'}
                />
              ) : (
                <span>{w.placeholder}</span>
              )}
            </div>
            <div class="meta">
              <div class="meta-text">
                <div class="name">{w.name}</div>
                <div class="muted">{w.text}</div>
              </div>
              <span class="cta">
                Ver web <Icon name="ph:arrow-up-right" size={16} />
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .inner {
    padding-block: 104px;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 24px;
  }

  .work {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: var(--ink);
  }

  .work-main {
    grid-column: 1 / -1;
    gap: 18px;
  }

  .work:hover {
    opacity: 1;
  }

  .work:hover .shot {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
  }

  .shot {
    aspect-ratio: 16 / 9;
    border-radius: var(--r-card);
    background: var(--soft);
    border: 1px solid var(--line);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
    transition: border-color 0.2s;
  }

  /* La principal va a todo el ancho y en la proporción de la captura (unos 2:1), sin recortes. */
  .work-main .shot {
    aspect-ratio: 1904 / 916;
  }

  .shot:has(img) {
    padding: 0;
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: 15px;
  }

  .meta-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .name {
    font-size: 19px;
    font-weight: 600;
  }

  .work-main .name {
    font-size: 22px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
    white-space: nowrap;
  }

  .cta :global(svg) {
    transition: transform 0.2s;
  }

  .work:hover .cta :global(svg) {
    transform: translate(2px, -2px);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .work-main .shot {
      aspect-ratio: 16 / 9;
    }
  }
</style>
