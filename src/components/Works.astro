---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { optionalImage } from '../lib/optional-image';

const main = {
  href: 'https://www.mcprimehome.com',
  name: 'MC Prime Home',
  text: 'Web para una agencia de Madrid y Florida',
  img: optionalImage('trabajos/mcprimehome.webp'),
  placeholder: '[Captura de mcprimehome.com, 1600×1360]',
};

const side = [
  {
    href: 'https://www.sirrux.net',
    name: 'SIRRUX',
    text: 'Proyecto propio de análisis financiero',
    img: optionalImage('trabajos/sirrux.webp'),
    placeholder: '[Captura de sirrux.net, 1600×900]',
  },
  {
    href: 'https://ova.vercel.app',
    name: 'OVA',
    text: '[Una línea sobre el proyecto]',
    img: optionalImage('trabajos/ova.webp'),
    placeholder: '[Captura de ova.vercel.app, 1600×900]',
  },
];
---

<section id="trabajos" class="band">
  <div class="wrap inner">
    <h2 class="display h2">Webs que ya están funcionando.</h2>
    <div class="grid">
      <a href={main.href} class="work work-main" target="_blank" rel="noopener">
        <div class="shot tall">
          {
            main.img ? (
              <Image
                src={main.img}
                alt={`Captura de la web de ${main.name}`}
                widths={[480, 800, 1200, 1600]}
                sizes="(max-width: 860px) 100vw, 600px"
              />
            ) : (
              <span>{main.placeholder}</span>
            )
          }
        </div>
        <div class="meta">
          <div class="meta-text">
            <div class="name name-lg">{main.name}</div>
            <div class="muted">{main.text}</div>
          </div>
          <span class="cta">Ver web <Icon name="ph:arrow-up-right" size={16} /><span class="sr-only">(se abre en una pestaña nueva)</span></span>
        </div>
      </a>

      <div class="col">
        {
          side.map((w) => (
            <a href={w.href} class="work" target="_blank" rel="noopener">
              <div class="shot wide">
                {w.img ? (
                  <Image
                    src={w.img}
                    alt={`Captura de la web de ${w.name}`}
                    widths={[480, 800, 1200, 1600]}
                    sizes="(max-width: 860px) 100vw, 600px"
                  />
                ) : (
                  <span>{w.placeholder}</span>
                )}
              </div>
              <div class="meta">
                <div class="meta-text">
                  <div class="name">{w.name}</div>
                  <div class="muted">{w.text}</div>
                </div>
                <span class="cta">
                  Ver web <Icon name="ph:arrow-up-right" size={16} />
                  <span class="sr-only">(se abre en una pestaña nueva)</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .inner {
    padding-block: 104px;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 24px;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .work {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: var(--ink);
  }

  .work-main {
    gap: 18px;
  }

  .work:hover {
    opacity: 1;
  }

  .work:hover .shot {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
  }

  .shot {
    border-radius: var(--r-card);
    background: var(--soft);
    border: 1px solid var(--line);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
    transition: border-color 0.2s;
  }

  .shot:has(img) {
    padding: 0;
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .tall {
    aspect-ratio: 4 / 3.4;
  }

  .wide {
    aspect-ratio: 16 / 9;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: 15px;
  }

  .meta-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .name {
    font-size: 19px;
    font-weight: 600;
  }

  .name-lg {
    font-size: 22px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
    white-space: nowrap;
  }

  .cta :global(svg) {
    transition: transform 0.2s;
  }

  .work:hover .cta :global(svg) {
    transform: translate(2px, -2px);
  }
</style>
