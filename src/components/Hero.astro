---
import { Icon } from 'astro-icon/components';
import { NV_FEED, NV_SCEN } from '../data/demo';

// Sin JS (o con movimiento reducido) se muestra la primera conversación completa.
const first = NV_SCEN[0];
---

<section id="inicio" class="wrap hero">
  <h1 class="display hero-title">Tu clínica atiende 24/7. <span class="muted">Tú, a tus pacientes.</span></h1>

  <div class="hero-grid">
    <div class="hero-copy">
      <p class="lead">
        Un asistente para tu web que responde dudas, reserva citas y te avisa de las urgencias mientras pasas consulta.
      </p>
      <div class="btn-row">
        <a href="#contacto" class="btn btn-lg btn-accent">Pide tu demo <Icon name="ph:arrow-right" size={18} /></a>
        <a href="#como-funciona" class="btn btn-lg btn-outline">Ver cómo funciona</a>
      </div>
      <div class="picker">
        <span id="picker-label" class="picker-label">Mira cómo respondería en cada caso:</span>
        <div role="group" aria-labelledby="picker-label" class="segmented">
          {
            NV_SCEN.map((s, i) => (
              <button type="button" class="seg" aria-pressed={i === 0 ? 'true' : 'false'} data-scen={i}>
                {s.label}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="stage" data-stage>
        <div class="feed-card">
          <div class="feed-title">Mientras dormías</div>
          {
            NV_FEED.map((f) => (
              <div class="feed-row">
                <span class="muted tnum">{f.t}</span>
                <span>{f.d}</span>
              </div>
            ))
          }
        </div>

        <div class="phone-col">
          <div class="phone">
            <div class="screen">
              <div class="chat-head">
                <div class="avatar" aria-hidden="true">VA</div>
                <div class="chat-meta">
                  <div class="chat-name">Veterinaria Arce</div>
                  <div class="chat-status">Responde al momento</div>
                </div>
              </div>
              <div class="chat" aria-live="off" data-chat>
                <div class="when" data-when>{first.when}</div>
                {first.messages.map((m) => <div class:list={['msg', m.from]}>{m.text}</div>)}
              </div>
              <div class="composer" aria-hidden="true">
                <div class="composer-field">Escribe un mensaje</div>
                <div class="send"><Icon name="ph:arrow-right-bold" size={16} /></div>
              </div>
            </div>
          </div>
          <div class="stage-caption">
            <p class="demo-note">Conversación de ejemplo con una clínica ficticia.</p>
            <button type="button" class="pause" data-pause hidden>
              <Icon name="ph:pause-fill" size={14} class="i-pause" />
              <Icon name="ph:play-fill" size={14} class="i-play" />
              <span data-pause-label>Pausar</span>
            </button>
          </div>
        </div>

        <div class="lead-card" data-lead>
          <div class="lead-icon"><Icon name="ph:check-bold" size={16} /></div>
          <div class="lead-text">
            <div class="lead-title" data-lead-title>{first.leadTitle}</div>
            <div class="muted" data-lead-1>{first.lead1}</div>
            <div class="muted" data-lead-2>{first.lead2}</div>
          </div>
        </div>
      </div>
      <p class="hero-foot">La clínica está cerrada. Las citas, no.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 48px;
    padding-bottom: 72px;
  }

  .hero-title {
    margin: 0 0 44px;
    max-width: 1180px;
    font-size: clamp(42px, 6.4vw, 92px);
    line-height: 1;
    animation: nv-in 0.7s var(--ease-out);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
    align-items: start;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 8px;
    max-width: 460px;
    animation: nv-in 0.9s var(--ease-out);
  }

  .lead {
    margin: 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
  }

  .btn-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .picker {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  :global(html:not(.js)) .picker {
    display: none;
  }

  .picker-label {
    font-size: 14px;
    color: var(--muted);
  }

  .segmented {
    display: inline-flex;
    flex-wrap: wrap;
    align-self: flex-start;
    padding: 4px;
    border-radius: var(--r-pill);
    background: var(--soft);
    border: 1px solid var(--line);
  }

  .seg {
    min-height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.25s;
  }

  .seg[aria-pressed='true'] {
    background: var(--accent);
    color: #fff;
  }

  .hero-visual {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .stage {
    position: relative;
    width: 100%;
    min-height: 664px;
    padding: 40px 56px 40px 24px;
    border-radius: var(--r-big);
    background: var(--accent-soft);
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .feed-card {
    position: absolute;
    top: 32px;
    left: 24px;
    z-index: 2;
    width: 232px;
    padding: 16px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 18px 40px -26px color-mix(in srgb, var(--accent) 50%, #000);
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: nv-in 1.1s var(--ease-out);
  }

  .feed-title {
    font-size: 13px;
    font-weight: 600;
  }

  .feed-row {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 8px;
    font-size: 12.5px;
    line-height: 1.4;
  }

  .tnum {
    font-variant-numeric: tabular-nums;
  }

  .phone-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .phone {
    width: 300px;
    max-width: 100%;
    border-radius: 44px;
    background: var(--phone);
    padding: 10px;
    box-shadow: 0 30px 60px -32px var(--accent-shadow);
  }

  .screen {
    height: 572px;
    border-radius: 35px;
    background: var(--surface);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 16px 12px;
    border-bottom: 1px solid var(--line);
  }

  .avatar {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 14px;
  }

  .chat-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .chat-name {
    font-size: 14px;
    font-weight: 600;
  }

  .chat-status {
    font-size: 12px;
    color: var(--muted);
  }

  .chat {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 14px;
    background: var(--chat);
  }

  .when {
    align-self: center;
    font-size: 11px;
    color: var(--muted);
    padding: 3px 10px;
    border-radius: var(--r-pill);
    background: var(--soft);
  }

  .chat :global(.msg) {
    flex-shrink: 0;
    padding: 9px 12px;
    font-size: 13.5px;
    line-height: 1.4;
  }

  .chat :global(.msg.is-new) {
    animation: nv-in 0.35s ease-out;
  }

  .chat :global(.msg.user) {
    align-self: flex-end;
    max-width: 82%;
    border-radius: 16px 16px 4px 16px;
    background: var(--accent);
    color: #fff;
  }

  .chat :global(.msg.bot) {
    align-self: flex-start;
    max-width: 86%;
    border-radius: 16px 16px 16px 4px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .chat :global(.typing) {
    flex-shrink: 0;
    align-self: flex-start;
    display: flex;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 16px 16px 16px 4px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .chat :global(.typing i) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    animation: nv-dot 1.2s infinite;
  }

  .chat :global(.typing i:nth-child(2)) {
    animation-delay: 0.2s;
  }

  .chat :global(.typing i:nth-child(3)) {
    animation-delay: 0.4s;
  }

  .composer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px 16px;
    border-top: 1px solid var(--line);
  }

  .composer-field {
    flex-grow: 1;
    padding: 10px 14px;
    border-radius: var(--r-pill);
    background: var(--chat);
    font-size: 13px;
    color: var(--muted);
  }

  .send {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stage-caption {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .demo-note {
    margin: 0;
    font-size: 12px;
    color: var(--muted);
  }

  .pause {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
  }

  .pause .i-play,
  .pause[aria-pressed='true'] .i-pause {
    display: none;
  }

  .pause[aria-pressed='true'] .i-play {
    display: block;
  }

  .lead-card {
    position: absolute;
    left: 24px;
    bottom: 40px;
    z-index: 2;
    width: 236px;
    padding: 14px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 18px 40px -22px color-mix(in srgb, var(--accent) 50%, #000);
    display: flex;
    gap: 10px;
  }

  .lead-card.is-new {
    animation: nv-in 0.4s ease-out;
  }

  .lead-icon {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lead-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 13px;
    line-height: 1.35;
  }

  .lead-title {
    font-weight: 600;
  }

  .hero-foot {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      max-width: none;
    }

    .stage {
      justify-content: center;
      min-height: auto;
      padding: 32px 16px 112px;
    }

    .feed-card {
      display: none;
    }

    .lead-card {
      left: 0;
      right: 0;
      bottom: 24px;
      margin-inline: auto;
    }
  }
</style>

<script>
  import { NV_SCEN } from '../data/demo';

  const TICK = 1600;
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const chat = document.querySelector<HTMLElement>('[data-chat]');
  const when = document.querySelector<HTMLElement>('[data-when]');
  const lead = document.querySelector<HTMLElement>('[data-lead]');
  const leadTitle = document.querySelector<HTMLElement>('[data-lead-title]');
  const lead1 = document.querySelector<HTMLElement>('[data-lead-1]');
  const lead2 = document.querySelector<HTMLElement>('[data-lead-2]');
  const pauseBtn = document.querySelector<HTMLButtonElement>('[data-pause]');
  const pauseLabel = document.querySelector<HTMLElement>('[data-pause-label]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-scen]'));

  if (stage && chat && when && lead && leadTitle && lead1 && lead2 && pauseBtn && pauseLabel) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    let scen = 0;
    let step = 1;
    let shownScen = -1;
    let shownCount = 0;
    let shownLead = false;
    let timer: number | undefined;
    let inView = true;
    let userPaused = false;

    const typing = document.createElement('div');
    typing.className = 'typing';
    typing.innerHTML = '<i></i><i></i><i></i><span class="sr-only">El asistente está escribiendo</span>';

    const bubble = (from: string, text: string, animate: boolean) => {
      const el = document.createElement('div');
      el.className = `msg ${from}${animate ? ' is-new' : ''}`;
      el.textContent = text;
      return el;
    };

    const render = (animate: boolean) => {
      const c = NV_SCEN[scen];
      const len = c.messages.length;
      const count = Math.min(step, len);

      if (shownScen !== scen || count < shownCount) {
        chat.querySelectorAll('.msg, .typing').forEach((el) => el.remove());
        when.textContent = c.when;
        leadTitle.textContent = c.leadTitle;
        lead1.textContent = c.lead1;
        lead2.textContent = c.lead2;
        shownScen = scen;
        shownCount = 0;
      }

      typing.remove();
      for (let k = shownCount; k < count; k++) {
        chat.append(bubble(c.messages[k].from, c.messages[k].text, animate));
      }
      shownCount = count;

      const next = c.messages[count];
      if (next && next.from === 'bot') chat.append(typing);

      const showLead = step > len;
      lead.hidden = !showLead;
      lead.classList.toggle('is-new', animate && showLead && !shownLead);
      shownLead = showLead;

      buttons.forEach((b, k) => b.setAttribute('aria-pressed', String(k === scen)));
    };

    const tick = () => {
      const len = NV_SCEN[scen].messages.length;
      if (step >= len + 4) {
        scen = (scen + 1) % NV_SCEN.length;
        step = 1;
        // Avance automático: no se anuncia en lectores de pantalla.
        chat.setAttribute('aria-live', 'off');
      } else {
        step += 1;
      }
      render(true);
    };

    const shouldRun = () => !reduce.matches && !userPaused && inView && !document.hidden;

    const sync = () => {
      if (shouldRun()) {
        if (timer === undefined) timer = window.setInterval(tick, TICK);
      } else if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const start = (n: number) => {
      scen = n;
      // Con movimiento reducido se muestra la conversación completa al instante.
      step = reduce.matches ? 99 : 1;
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
      render(!reduce.matches);
      sync();
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        chat.setAttribute('aria-live', 'polite');
        start(Number(b.dataset.scen));
      }),
    );

    pauseBtn.addEventListener('click', () => {
      userPaused = !userPaused;
      pauseBtn.setAttribute('aria-pressed', String(userPaused));
      pauseLabel.textContent = userPaused ? 'Reanudar' : 'Pausar';
      sync();
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        sync();
      }).observe(stage);
    }

    document.addEventListener('visibilitychange', sync);

    const applyMotionPref = () => {
      pauseBtn.hidden = reduce.matches;
      pauseBtn.setAttribute('aria-pressed', String(userPaused));
      start(scen);
    };
    reduce.addEventListener('change', applyMotionPref);

    // Con movimiento reducido ya está pintada la conversación completa desde el servidor.
    shownScen = 0;
    shownCount = NV_SCEN[0].messages.length;
    shownLead = true;
    applyMotionPref();
  }
</script>
