---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Country } from '../data/countries';

interface Props {
  page: CollectionEntry<'legal'> | CollectionEntry<'legalCo'>;
  country?: Country;
}

const { page, country } = Astro.props;
const { Content, headings } = await render(page);
const toc = headings.filter((h) => h.depth === 2);
---


<BaseLayout title={`${page.data.title} · Novusance`} description={page.data.description} country={country}>
  <article class="wrap legal">
    <header class="head">
      <h1 class="display title">{page.data.title}</h1>
      <p class="updated">Última actualización: {page.data.updated}</p>
    </header>

    {
      toc.length > 1 && (
        <nav class="toc" aria-labelledby="toc-title">
          <h2 id="toc-title" class="toc-title">
            Índice
          </h2>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .legal {
    padding-block: 64px 104px;
  }

  .legal > * {
    max-width: 70ch;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 36px;
  }

  .title {
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.04;
  }

  .updated {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }

  .toc {
    margin-bottom: 48px;
    padding: 24px 28px;
    border-radius: var(--r-card);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .toc-title {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--accent-text);
    opacity: 1;
  }

  .prose {
    font-size: 17px;
    line-height: 1.7;
  }

  .prose :global(h2) {
    margin: 48px 0 12px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 700;
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    scroll-margin-top: 92px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 16px;
  }

  .prose :global(li) {
    margin-bottom: 6px;
  }

  .prose :global(a) {
    color: var(--accent-text);
    text-underline-offset: 3px;
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin: 8px 0 24px;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.5;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--soft);
    font-weight: 600;
  }
</style>
