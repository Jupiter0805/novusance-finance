---
import { Icon } from 'astro-icon/components';
import { FEE_INCLUDES, NOT_INCLUDED, type Country } from '../data/countries';

const { country } = Astro.props as { country: Country };
---

<section id="precios" class="wrap pricing">
  <div class="intro">
    <h2 class="display h2">Un pago para ponerla en marcha. Una cuota para tenerla al día.</h2>
    <p class="sub">
      Cada negocio es distinto, así que el precio final va en tu presupuesto por escrito. Estos son los puntos de partida.
    </p>
  </div>

  <div class="grid">
    {
      country.plans.map((p) => (
        <article class:list={['plan', { featured: p.featured }]} aria-labelledby={`plan-${p.id}`}>
          <div class="top">
            <h3 class="name" id={`plan-${p.id}`}>
              {p.name}
            </h3>
            <p class="for">{p.forWho}</p>
          </div>
          <div class="price">
            <span class="from">desde</span>
            <span class="display amount">{p.setupFrom}</span>
            <span class="fee">
              + <strong>{p.fee}</strong> al mes de mantenimiento
            </span>
          </div>
          <ul class="features">
            {p.features.map((f) => (
              <li>
                <Icon name="ph:check-bold" size={15} />
                {f}
              </li>
            ))}
          </ul>
          <a href="#contacto" class:list={['btn', 'plan-btn', p.featured ? 'btn-accent' : 'btn-plain']}>
            Pide tu propuesta<span class="sr-only"> ({p.name})</span>
          </a>
        </article>
      ))
    }

    <aside class="fee-box" aria-labelledby="cuota-incluye">
      <h3 class="name" id="cuota-incluye">La cuota incluye</h3>
      <ul class="features">
        {
          FEE_INCLUDES.map((f) => (
            <li>
              <Icon name="ph:check-bold" size={15} />
              {f}
            </li>
          ))
        }
      </ul>
      <p class="aside-note">Se presupuesta aparte: {NOT_INCLUDED.charAt(0).toLowerCase() + NOT_INCLUDED.slice(1)}</p>
    </aside>
  </div>

  <ul class="notes">
    <li>{country.taxNote} {country.terms}</li>
    <li>{country.noFee}</li>
  </ul>
</section>

<style>
  .pricing {
    padding-block: 104px;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 760px;
  }

  .sub {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.85fr);
    gap: 16px;
    align-items: stretch;
  }

  .plan,
  .fee-box {
    padding: 32px;
    border-radius: var(--r-card);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .plan {
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .featured {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .fee-box {
    background: var(--accent-soft);
  }

  .top {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .name {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }

  .for,
  .from,
  .fee {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }

  .price {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .amount {
    font-size: clamp(44px, 4.4vw, 56px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .fee strong {
    color: var(--ink);
    font-weight: 600;
  }

  .featured .for,
  .featured .from,
  .featured .fee {
    color: color-mix(in srgb, var(--bg) 72%, var(--ink));
  }

  .featured .fee strong {
    color: var(--bg);
  }

  .features {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
    flex-grow: 1;
  }

  .features li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  .features :global(svg) {
    flex-shrink: 0;
    position: relative;
    top: 2px;
    color: var(--accent-text);
  }

  .featured .features :global(svg) {
    color: color-mix(in srgb, var(--accent) 55%, #fff);
  }

  .plan-btn {
    min-height: 48px;
  }

  .btn-plain {
    border-color: var(--line);
    color: var(--ink);
  }

  .featured :focus-visible {
    outline-color: var(--bg);
  }

  .aside-note {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }

  .notes {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fee-box {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
