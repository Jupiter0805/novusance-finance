---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import { LIMITS } from '../lib/contact-validation';

// Clave pública de Turnstile. En desarrollo, si no está definida, se usa la clave de pruebas que siempre pasa.
const TEST_SITE_KEY = '1x00000000000000000000AA';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? TEST_SITE_KEY : '');
if (!siteKey) console.warn('[contacto] Falta PUBLIC_TURNSTILE_SITE_KEY: el formulario no pasará la verificación antispam.');
---

<section id="contacto" class="wrap contact">
  <div class="box">
    <Logo size={240} gradient class="big-logo" />

    <h2 class="display title">¿Te enseño cómo quedaría en tu clínica?</h2>
    <p class="intro">
      Dime el nombre de tu clínica y te preparo una demo con tus servicios y horarios. Sin compromiso.
    </p>

    <div class="messages" aria-live="polite">
      <div class="msg msg-ok" tabindex="-1" data-success hidden>
        <Icon name="ph:check-circle" size={24} />
        <p>¡Gracias! Te escribo en menos de 24 horas laborables.</p>
      </div>
      <div class="msg msg-error" tabindex="-1" data-failure hidden>
        <Icon name="ph:warning-circle" size={24} />
        <p>
          <span data-failure-text>No se ha podido enviar el formulario.</span>
          Inténtalo de nuevo en unos minutos o escríbeme a <a href="mailto:hola@novusance.com">hola@novusance.com</a>.
        </p>
      </div>
    </div>

    <form
      class="form"
      action="/api/contact"
      method="post"
      data-contact-form
      data-sitekey={siteKey}
      aria-label="Solicitud de demo"
    >
      <div class="grid">
        <div class="field">
          <label for="f-nombre">Nombre</label>
          <input
            id="f-nombre"
            name="nombre"
            type="text"
            autocomplete="name"
            required
            maxlength={LIMITS.nombre}
            aria-describedby="e-nombre"
          />
          <p class="error" id="e-nombre" data-error-for="nombre"></p>
        </div>

        <div class="field">
          <label for="f-clinica">Nombre de la clínica</label>
          <input
            id="f-clinica"
            name="clinica"
            type="text"
            autocomplete="organization"
            required
            maxlength={LIMITS.clinica}
            aria-describedby="e-clinica"
          />
          <p class="error" id="e-clinica" data-error-for="clinica"></p>
        </div>

        <div class="field">
          <label for="f-email">Email</label>
          <input
            id="f-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            maxlength={LIMITS.email}
            aria-describedby="e-email"
          />
          <p class="error" id="e-email" data-error-for="email"></p>
        </div>

        <div class="field">
          <label for="f-telefono">Teléfono <span class="optional">(opcional)</span></label>
          <input
            id="f-telefono"
            name="telefono"
            type="tel"
            autocomplete="tel"
            maxlength={LIMITS.telefono}
            aria-describedby="e-telefono"
          />
          <p class="error" id="e-telefono" data-error-for="telefono"></p>
        </div>

        <div class="field full">
          <label for="f-mensaje">¿En qué te puedo ayudar? <span class="optional">(opcional)</span></label>
          <textarea id="f-mensaje" name="mensaje" rows="4" maxlength={LIMITS.mensaje} aria-describedby="e-mensaje"
          ></textarea>
          <p class="error" id="e-mensaje" data-error-for="mensaje"></p>
        </div>

        <!-- Campo trampa: invisible para personas; si llega relleno, es un bot. -->
        <div class="hp" aria-hidden="true">
          <label for="f-website">No rellenes este campo</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field full">
          <div class="check">
            <input id="f-privacidad" name="privacidad" type="checkbox" required aria-describedby="e-privacidad" />
            <label for="f-privacidad">He leído y acepto la <a href="/privacidad">política de privacidad</a>.</label>
          </div>
          <p class="error" id="e-privacidad" data-error-for="privacidad"></p>
        </div>
      </div>

      <div class="turnstile" data-turnstile></div>

      <noscript>
        <p class="noscript">
          Para enviar el formulario hace falta JavaScript (lo uso para la protección antispam). Si lo prefieres,
          escríbeme a <a href="mailto:hola@novusance.com">hola@novusance.com</a>.
        </p>
      </noscript>

      <div class="submit-row">
        <button type="submit" class="btn btn-accent submit" data-submit>
          <span data-submit-label>Pide tu demo</span>
          <Icon name="ph:arrow-right" size={18} />
        </button>
        <a href="mailto:hola@novusance.com" class="mail">hola@novusance.com</a>
      </div>

      <p class="rgpd">
        <strong>Responsable:</strong> [NOMBRE COMPLETO DEL TITULAR].{' '}
        <strong>Finalidad:</strong> responder a tu solicitud y preparar tu demo.{' '}
        <strong>Legitimación:</strong> tu consentimiento.{' '}
        <strong>Destinatarios:</strong> no se ceden datos a terceros, salvo obligación legal; los proveedores técnicos
        tratan los datos por cuenta del responsable.{' '}
        <strong>Derechos:</strong> acceso, rectificación, supresión y otros, escribiendo a hola@novusance.com.{' '}
        Más información en la <a href="/privacidad">política de privacidad</a>.
      </p>
    </form>
  </div>
</section>

<style>
  .contact {
    padding-block: 120px;
  }

  .box {
    position: relative;
    overflow: hidden;
    padding: 64px 48px;
    border-radius: var(--r-big);
    background: var(--accent-soft);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 26px;
  }

  .box :global(.big-logo) {
    position: absolute;
    right: 56px;
    bottom: 40px;
  }

  .title {
    max-width: 760px;
    font-size: clamp(38px, 5.2vw, 70px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .intro {
    margin: 0;
    max-width: 540px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }

  .messages,
  .form {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 680px;
  }

  .messages:empty {
    display: none;
  }

  .msg {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 18px 20px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 17px;
    line-height: 1.5;
  }

  .msg p {
    margin: 0;
  }

  .msg :global(svg) {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .msg-ok :global(svg) {
    color: var(--accent-text);
  }

  .msg-error {
    border-color: color-mix(in srgb, var(--danger) 45%, var(--line));
  }

  .msg-error :global(svg) {
    color: var(--danger);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .full {
    grid-column: 1 / -1;
  }

  label {
    font-size: 15px;
    font-weight: 500;
  }

  .optional {
    font-weight: 400;
    color: var(--muted);
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  textarea {
    width: 100%;
    min-height: 50px;
    padding: 0 20px;
    border: 1px solid var(--field);
    border-radius: var(--r-pill);
    background: var(--surface);
    font-size: 16px;
    transition: border-color 0.2s;
  }

  textarea {
    min-height: 120px;
    padding: 14px 20px;
    border-radius: 20px;
    resize: vertical;
    line-height: 1.5;
  }

  input:hover,
  textarea:hover {
    border-color: var(--ink);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline-offset: 1px;
    border-color: var(--accent-text);
  }

  [aria-invalid='true'] {
    border-color: var(--danger) !important;
  }

  .error {
    min-height: 20px;
    margin: 0 0 6px;
    padding-left: 4px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--danger);
  }

  .check {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .check input {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin: 1px 0 0;
    accent-color: var(--accent);
  }

  .check label {
    font-weight: 400;
    line-height: 1.5;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .turnstile:empty {
    display: none;
  }

  .noscript {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }

  .submit-row {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .submit {
    min-height: 54px;
    padding: 0 28px;
    font-size: 16px;
  }

  .submit:disabled {
    cursor: progress;
    opacity: 0.75;
  }

  .mail {
    font-size: 16px;
  }

  .rgpd {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }

  .rgpd strong {
    font-weight: 600;
  }

  .rgpd a {
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .box :global(.big-logo) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .contact {
      padding-block: 72px;
    }

    .box {
      padding: 40px 20px;
      border-radius: var(--r-card);
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import '../scripts/contact-form';
</script>
