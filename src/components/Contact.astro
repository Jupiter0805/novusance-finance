---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import { LIMITS } from '../lib/contact-validation';
import type { Country } from '../data/countries';

const { country } = Astro.props as { country: Country };
const email = country.email;
const privacy = `${country.legalBase}/privacidad`;
// Responsable del tratamiento de los datos del formulario: la persona que lleva Novusance en ese país.
const controller = country.code === 'es' ? 'Juan Ignacio Moreno Cordido' : country.person.name;
---

<section id="contacto" class="wrap contact">
  <div class="box">
    <div class="head">
      <div class="head-text">
        <h2 class="display title">¿Te enseño cómo quedaría tu web?</h2>
        <p class="intro">
          Dime el nombre de tu clínica y te preparo una propuesta de portada con tu logo y tus colores. Sin coste y sin
          compromiso.
        </p>
      </div>
      <Logo size={132} gradient class="big-logo" />
    </div>

    <div class="main">
      <div class="messages" aria-live="polite">
        <div class="msg msg-ok" tabindex="-1" data-success hidden>
          <Icon name="ph:check-circle" size={24} />
          <p>¡Gracias! Te escribo en menos de 24 horas laborables.</p>
        </div>
        <div class="msg msg-error" tabindex="-1" data-failure hidden>
          <Icon name="ph:warning-circle" size={24} />
          <p>
            <span data-failure-text>No se ha podido enviar el formulario.</span>
            Inténtalo de nuevo en unos minutos o escríbeme a <a href={`mailto:${email}`}>{email}</a>.
          </p>
        </div>
      </div>

      <form
        class="form"
        action="/api/contact"
        method="post"
        data-contact-form
        aria-label="Solicitud de propuesta"
      >
        <div class="grid">
          <div class="field">
            <label for="f-nombre">Nombre</label>
            <input
              id="f-nombre"
              name="nombre"
              type="text"
              autocomplete="name"
              required
              maxlength={LIMITS.nombre}
              aria-describedby="e-nombre"
            />
            <p class="error" id="e-nombre" data-error-for="nombre"></p>
          </div>

          <div class="field">
            <label for="f-clinica">Nombre de la clínica</label>
            <input
              id="f-clinica"
              name="clinica"
              type="text"
              autocomplete="organization"
              required
              maxlength={LIMITS.clinica}
              aria-describedby="e-clinica"
            />
            <p class="error" id="e-clinica" data-error-for="clinica"></p>
          </div>

          <div class="field">
            <label for="f-email">Email</label>
            <input
              id="f-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              maxlength={LIMITS.email}
              aria-describedby="e-email"
            />
            <p class="error" id="e-email" data-error-for="email"></p>
          </div>

          <div class="field">
            <label for="f-telefono">Teléfono <span class="optional">(opcional)</span></label>
            <input
              id="f-telefono"
              name="telefono"
              type="tel"
              autocomplete="tel"
              maxlength={LIMITS.telefono}
              aria-describedby="e-telefono"
            />
            <p class="error" id="e-telefono" data-error-for="telefono"></p>
          </div>

          <div class="field full">
            <label for="f-mensaje">¿En qué te puedo ayudar? <span class="optional">(opcional)</span></label>
            <textarea id="f-mensaje" name="mensaje" rows="2" maxlength={LIMITS.mensaje} aria-describedby="e-mensaje"
            ></textarea>
            <p class="error" id="e-mensaje" data-error-for="mensaje"></p>
          </div>

          <!-- Campo trampa: invisible para personas; si llega relleno, es un bot. -->
          <div class="hp" aria-hidden="true">
            <label for="f-website">No rellenes este campo</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
        </div>

        <input type="hidden" name="pais" value={country.code} />
        <!-- Antispam: el script pone aquí la hora de apertura; el servidor descarta envíos de menos de 3 segundos. -->
        <input type="hidden" name="t" value="" data-started-at />

        <div class="submit-row">
          <div class="consent">
            <div class="check">
              <input id="f-privacidad" name="privacidad" type="checkbox" required aria-describedby="e-privacidad" />
              <label for="f-privacidad">He leído y acepto la <a href={privacy}>política de privacidad</a>.</label>
            </div>
            <p class="error" id="e-privacidad" data-error-for="privacidad"></p>
          </div>
          <div class="send">
            <p class="direct">o escríbeme a <a href={`mailto:${email}`}>{email}</a></p>
            <button type="submit" class="btn btn-accent submit" data-submit>
              <span data-submit-label>Pide tu propuesta</span>
              <Icon name="ph:arrow-right" size={18} />
            </button>
          </div>
        </div>

        <p class="rgpd">
          <strong>Responsable:</strong> {controller}.{' '}
          <strong>Finalidad:</strong> responder a tu solicitud y preparar tu propuesta.{' '}
          <strong>Legitimación:</strong> tu consentimiento.{' '}
          <strong>Destinatarios:</strong> no se ceden datos a terceros, salvo obligación legal; los proveedores técnicos
          tratan los datos por cuenta del responsable.{' '}
          <strong>Derechos:</strong> acceso, rectificación, supresión y otros, escribiendo a {email}.{' '}
          Más información en la <a href={privacy}>política de privacidad</a>.
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: 104px;
  }

  .box {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 44px 56px;
    border-radius: var(--r-big);
    background: var(--accent-soft);
  }

  /* ── Cabecera: mensaje a la izquierda, logo a la derecha ───────── */
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .head-text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 860px;
  }

  .title {
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .intro {
    margin: 0;
    max-width: 820px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }

  .head :global(.big-logo) {
    flex-shrink: 0;
    margin-right: 8px;
  }

  /* ── Formulario a todo el ancho ────────────────────────────────── */
  .main {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .send {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .direct {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }

  .direct a {
    font-weight: 500;
    color: var(--ink);
  }

  /* El contenedor de mensajes solo ocupa sitio cuando hay uno visible. */
  .messages:not(:has(> :not([hidden]))) {
    display: none;
  }

  .msg {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 18px 20px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 17px;
    line-height: 1.5;
  }

  .msg p {
    margin: 0;
  }

  .msg :global(svg) {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .msg-ok :global(svg) {
    color: var(--accent-text);
  }

  .msg-error {
    border-color: color-mix(in srgb, var(--danger) 45%, var(--line));
  }

  .msg-error :global(svg) {
    color: var(--danger);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .full {
    grid-column: 1 / -1;
  }

  label {
    font-size: 14px;
    font-weight: 500;
  }

  .optional {
    font-weight: 400;
    color: var(--muted);
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  textarea {
    width: 100%;
    min-height: 46px;
    padding: 0 18px;
    border: 1px solid var(--field);
    border-radius: var(--r-pill);
    background: var(--surface);
    font-size: 16px;
    transition: border-color 0.2s;
  }

  textarea {
    min-height: 72px;
    padding: 11px 18px;
    border-radius: 18px;
    resize: vertical;
    line-height: 1.5;
  }

  input:hover,
  textarea:hover {
    border-color: var(--ink);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline-offset: 1px;
    border-color: var(--accent-text);
  }

  [aria-invalid='true'] {
    border-color: var(--danger) !important;
  }

  /* Los errores solo ocupan espacio cuando hay mensaje. */
  .error {
    margin: 0;
    padding-left: 4px;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--danger);
  }

  .error:empty {
    display: none;
  }

  .submit-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    flex-wrap: wrap;
  }

  .consent {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 1 260px;
  }

  .check {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .check input {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin: 1px 0 0;
    accent-color: var(--accent);
  }

  .check label {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.45;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit {
    min-height: 52px;
    padding: 0 28px;
    font-size: 16px;
  }

  .submit:disabled {
    cursor: progress;
    opacity: 0.75;
  }

  .rgpd {
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .rgpd strong {
    font-weight: 600;
  }

  .rgpd a {
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .box {
      padding: 40px 32px;
    }

    .head :global(.big-logo) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .contact {
      padding-block: 72px;
    }

    .box {
      padding: 36px 20px;
      border-radius: var(--r-card);
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .send,
    .submit {
      width: 100%;
    }
  }
</style>

<script>
  import '../scripts/contact-form';
</script>
