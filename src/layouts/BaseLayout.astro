---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/host-grotesk/400.css';
import '@fontsource/host-grotesk/500.css';
import '@fontsource/host-grotesk/600.css';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import hostLatin from '@fontsource/host-grotesk/files/host-grotesk-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { COUNTRIES, PUBLISHED, type Country } from '../data/countries';

interface Props {
  title: string;
  description: string;
  /** Portada: anclas directas en la cabecera y datos estructurados. */
  home?: boolean;
  noindex?: boolean;
  /** País de la página. Por defecto España (páginas legales, 404). */
  country?: Country;
  /** og:type. "article" en las guías. */
  type?: 'website' | 'article';
}

const { title, description, home = false, country = COUNTRIES.es, type = 'website' } = Astro.props;
// Un país en borrador nunca se indexa.
const noindex = Astro.props.noindex || !country.published;
const site = Astro.site ?? new URL('https://www.novusance.com');
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), site).href;
const ogImage = new URL('/og.png', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Novusance',
  url: site.href,
  logo: new URL('/Novusance-Logo.png', site).href,
  image: ogImage,
  description,
  email: country.email,
  areaServed: { '@type': 'Country', name: country.areaServed },
};

// Versiones de la portada en cada país publicado, para que los buscadores sirvan la que toca.
const alternates = home && country.published ? PUBLISHED.map((c) => ({ lang: c.lang, href: new URL(c.path, site).href })) : [];
---

<!doctype html>
<html lang={country.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL('/es', site).href} />}

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={hostLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F4F5F2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1110" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={country.ogLocale} />
    <meta property="og:site_name" content="Novusance" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Novusance: la web de tu clínica, a la altura de tu clínica." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {home && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <slot name="head" />

    <!-- Analítica: Vercel Web Analytics (sin cookies), activada en astro.config.mjs. -->
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {
      !country.published && (
        <div class="draft" role="note">
          Borrador de {country.name}: no indexado ni enlazado. Faltan datos por confirmar antes de publicarlo.
        </div>
      )
    }
    <Header home={home} country={country} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer country={country} />
    <CookieConsent country={country} />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  .draft {
    padding: 10px var(--gutter);
    background: #fde68a;
    color: #3d2c00;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
  }
</style>
