# ── Cliente (se incrusta en el HTML durante el build) ─────────────────
# Clave pública del widget de Cloudflare Turnstile.
# Para pruebas: 1x00000000000000000000AA (siempre pasa).
PUBLIC_TURNSTILE_SITE_KEY=

# ── Servidor (endpoint /api/contact) ──────────────────────────────────
# En local van en .env; en producción, en Vercel > Settings > Environment Variables.
# Clave secreta de Turnstile. Para pruebas: 1x0000000000000000000000000000000AA (siempre pasa).
TURNSTILE_SECRET_KEY=
# API key de Resend (https://resend.com/api-keys), con permiso "Sending access".
RESEND_API_KEY=
# Destinatario de las solicitudes (admite varios separados por comas).
CONTACT_TO=hola@novusance.com
# Destinatario de las solicitudes enviadas desde /co (Colombia). Si se deja vacío, van a CONTACT_TO.
CONTACT_TO_CO=
# Remitente; el dominio debe estar verificado en Resend.
CONTACT_FROM=Novusance <web@novusance.com>

# Solo en local (.env): 1 = valida todo y verifica Turnstile, pero no envía el email.
# CONTACT_DRY_RUN=1

# ── Panel /admin (Supabase) ───────────────────────────────────────────
# Supabase > Project Settings > API. Solo la clave anon (pública); NUNCA la service_role.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (sb_secret_...) para guardar los mensajes del formulario en Supabase. SOLO servidor; en Vercel, como Secret.
SUPABASE_SECRET_KEY=
